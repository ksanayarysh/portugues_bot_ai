# Telegram Bot Token (получи у @BotFather)
BOT_TOKEN=your_bot_token_here

# Anthropic API Key (получи на https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# Модель Claude (по умолчанию используется Sonnet 4)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PostgreSQL Database URL
# Railway автоматически установит эту переменную при добавлении Postgres
DATABASE_URL=postgresql://user:password@host:port/database

# Настройки рассылки (опционально)
DEFAULT_LESSON_HOUR=9
DEFAULT_LESSON_MINUTE=0
